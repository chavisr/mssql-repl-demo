# Copy to cloud.env, fill in your existing cloud resources, then source the file.
# Bash syntax: quote values containing spaces or shell metacharacters.
export MI_SERVER='your-mi.your-dns-zone.database.windows.net,1433'
export MI_LOGIN='your-mi-admin'
export MI_PASSWORD='CHANGE_ME'

# Use the RDS DNS endpoint, not its current IP or internal Windows server name.
export RDS_SERVER='your-rds.your-id.your-region.rds.amazonaws.com,1433'
export RDS_LOGIN='your-rds-admin'
export RDS_PASSWORD='CHANGE_ME'

export SNAPSHOT_SHARE='\\yourstorage.file.core.windows.net\replshare'
export STORAGE_CONNECTION_STRING='DefaultEndpointsProtocol=https;AccountName=yourstorage;AccountKey=CHANGE_ME;EndpointSuffix=core.windows.net'
export DISTRIBUTION_KEY_PASSWORD='CHANGE_ME'
